{
  "name": "codi.link",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "main": "electron/main.js",
  "author": "Miguel Ángel Durán",
  "description": "HTML, CSS and JavaScript playground",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "lint": "eslint .",
    "electron:dev": "bun electron/dev.js",
    "electron:build": "vite build && electron-builder",
    "phoenix": "rm -rf ./node_modules && bun install",
    "postinstall": "git config core.hooksPath ./git-hooks",
    "serve": "vite preview"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "10.8.1",
    "globals": "17.11.0",
    "postcss": "8.5.26",
    "postcss-nesting": "14.0.1",
    "vite": "8.2.1"
  },
  "dependencies": {
    "client-zip": "2.5.0",
    "emmet-monaco-es": "5.7.0",
    "escape-html": "1.0.3",
    "monaco-editor": "0.56.0",
    "split-grid": "1.0.11",
    "zustand": "5.0.15"
  },
  "postcss": {
    "plugins": {
      "postcss-nesting": {}
    }
  },
  "build": {
    "appId": "midudev.codi.link",
    "productName": "codi.link",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "icon": "electron/icons/icon.png",
    "mac": {
      "icon": "electron/icons/icon.icns",
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg"
      ]
    },
    "win": {
      "icon": "electron/icons/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "icon": "electron/icons/icon.png",
      "category": "Development",
      "target": [
        "AppImage"
      ]
    },
    "publish": {
      "provider": "github",
      "releaseType": "draft"
    }
  }
}
